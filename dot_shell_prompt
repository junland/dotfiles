# ------------------------------------------------------------------------------
# Bash Configuration
# ------------------------------------------------------------------------------
if [ -n "${BASH_VERSION-}" ]; then
    # Terminal ANSI Colors (wrapped in \[ \] for Bash prompt tracking)
    if [ -t 1 ]; then
        C_GREEN='\[\e[0;32m\]'
        C_BLUE='\[\e[1;34m\]'
        C_RED='\[\e[1;31m\]'
        C_BOLD='\[\e[1m\]'
        C_RESET='\[\e[0m\]'
    else
        C_GREEN='' C_BLUE='' C_RED='' C_BOLD='' C_RESET=''
    fi

    # Root / User styling
    if [ "$EUID" -eq 0 ]; then
        U_COLOR="$C_RED"
        SYMBOL="# "
    else
        U_COLOR="$C_BLUE"
        SYMBOL="$ "
    fi

    # Build PS1 string
    PS1="${C_GREEN}┌──${C_RESET}"
    PS1+="(${U_COLOR}\u@\h${C_GREEN})-[${C_BOLD}\w${C_GREEN}]"
    PS1+="${C_RESET}"
    PS1+="\n"
    PS1+="${C_GREEN}└─${U_COLOR}${SYMBOL} ${C_RESET}"
fi

# ------------------------------------------------------------------------------
# Zsh Configuration
# ------------------------------------------------------------------------------
if [ -n "${ZSH_VERSION-}" ]; then
    # Root / User symbol
    if [ "$EUID" -eq 0 ]; then
        U_SYMBOL="%F{red}#%f "
    else
        U_SYMBOL="%F{blue}➜%f "
    fi

    # Build PROMPT string using Zsh native prompt expansions
    PROMPT='%F{green}┌──%f'
    PROMPT+='(%F{blue}%n@%m%F{green})-[%B%~%b]'
    PROMPT+=$'\n'
    PROMPT+="%F{green}└─${U_SYMBOL} "
fi
