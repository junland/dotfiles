# Managed by chezmoi

# Source global definitions
if [ -f /etc/bashrc ]; then
        . /etc/bashrc
fi

# Source Aphrodite theme for Bash prompt
if [ -f "$HOME/.config/bash/aphrodite_theme.sh" ]; then
    source "$HOME/.config/bash/aphrodite_theme.sh"
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Keep 3000 lines of history within the shell and save it to ~/.bash_history:
HISTSIZE=3000
SAVEHIST=3000
HISTFILE=~/.bash_history

# GOPATH and Go binaries
export GOPATH="$HOME/.local/share/go"
export PATH="$GOPATH/bin:$PATH"

# XDG configuration directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# Homebrew 
export HOMEBREW_NO_ENV_HINTS=1

# Setup program completion
command -v aws_completer > /dev/null 2>&1 && source <(complete -C aws_completer aws)
command -v fly > /dev/null 2>&1 && source <(fly completion --shell bash)
command -v gh > /dev/null 2>&1 && source <(gh completion -s bash)
command -v glab > /dev/null 2>&1 && source <(glab completion -s bash)
command -v helm > /dev/null 2>&1 && source <(helm completion bash)
command -v kubectl > /dev/null 2>&1 && source <(kubectl completion bash)
command -v uv > /dev/null 2>&1 && source <(uv generate-shell-completion bash)

# Aliases
alias ansible-local='ansible -i "localhost," -c local'
alias ansible-playbook-local='ansible-playbook -i "localhost," -c local'
alias ansible-playbook-localhost='ansible-playbook-local'
alias ll='ls -alF'
alias la='ls -A'