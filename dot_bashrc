case $- in *i*) ;; *) return 0 ;; esac

if [ -r /etc/bashrc ]; then . /etc/bashrc; fi
. "$HOME/.config/shell/env"
if [ -r "$HOME/.shell_prompt" ]; then . "$HOME/.shell_prompt"; fi

: "${HISTSIZE:=3000}" "${HISTFILESIZE:=3000}" "${HISTFILE:=$HOME/.bash_history}"
if command -v aws_completer >/dev/null && ! complete -p aws >/dev/null 2>&1; then
    complete -C aws_completer aws
fi
if [ -r "$HOME/.config/shell/local" ]; then . "$HOME/.config/shell/local"; fi
