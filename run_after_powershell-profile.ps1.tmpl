{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

$source = '{{ joinPath .chezmoi.sourceDir "dot_config" "powershell" "profile.ps1" | replace "'" "''" }}'
foreach ($shell in 'pwsh', 'powershell') {
	$command = Get-Command $shell -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
	if ($command) {
		$profilePath = & $command.Source -NoProfile -NonInteractive -Command '$PROFILE.CurrentUserCurrentHost'
		if ($LASTEXITCODE -ne 0 -or -not $profilePath) {
			throw "Could not determine the profile path for $shell"
		}
		New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null
		Copy-Item -LiteralPath $source -Destination $profilePath -Force
		break
	}
}
{{ end -}}