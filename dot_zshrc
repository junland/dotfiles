[[ -o interactive ]] || return 0
. "$HOME/.config/shell/env"
if [[ -r "$HOME/.shell_prompt" ]]; then . "$HOME/.shell_prompt"; fi

: "${HISTFILE:=$HOME/.zsh_history}"
if (( ! SAVEHIST )); then
    HISTSIZE=3000
    SAVEHIST=3000
    setopt histignorealldups sharehistory
fi

if (( ! $+functions[compdef] )); then
    autoload -Uz compinit && compinit -i
fi
if command -v aws_completer >/dev/null && [[ -z ${_comps[aws]-} ]]; then
    if (( ! $+functions[complete] )); then
        autoload -Uz bashcompinit && bashcompinit
    fi
    complete -C aws_completer aws
fi
if [[ -r "$HOME/.config/shell/local" ]]; then . "$HOME/.config/shell/local"; fi
